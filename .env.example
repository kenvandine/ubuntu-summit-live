# Discourse instance to sign in against (no trailing slash)
VITE_DISCOURSE_URL=https://discourse.ubuntu.com
# Name shown on Discourse's "authorize application" page
VITE_APP_NAME=Ubuntu Summit Live
# Base path the app is served from (GitHub Pages project path)
BASE_PATH=/ubuntu-summit-live/
# Emoji set configured on the Discourse site, used for reaction images
VITE_EMOJI_SET=twitter
